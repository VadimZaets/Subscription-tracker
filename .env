# expo-router лишається транзитивною залежністю @expo/cli (dev-тулінг), навіть
# після повного видалення з app-коду й package.json — Expo CLI все одно бачить
# пакет у node_modules і виводить хибну помилку конфлікту з react-navigation.
# Застосунок реально не імпортує expo-router ніде.
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
