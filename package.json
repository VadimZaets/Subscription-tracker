    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "executableFiles": [
      "./android/gradlew"
    ]
  },
  "overrides": {
    "react-dom": "19.2.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
